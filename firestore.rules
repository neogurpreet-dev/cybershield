rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Everything a user creates lives under their own document. Nobody else can read or write it.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // SOS live-tracking sessions. Readable by anyone who has the exact random link (get only,
    // never list), so contacts can follow without an account. Only the owner can write.
    match /sosSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && sessionId.size() >= 20
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 100;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
